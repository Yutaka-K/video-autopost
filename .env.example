# =====================================================================
#  動画自動投稿ツール 設定ファイル
# ---------------------------------------------------------------------
#  このファイルをコピーして「.env」という名前にして使います。
#  （「初回セットアップ.bat」を実行すると自動でコピーされます）
#
#  ★「.env」にはパスワードと同じくらい大事な情報を書きます。
#    他人に見せたり、GitHub にアップロードしたりしないでください。
#    （.gitignore で自動的に除外されるようになっています）
#
#  書き方: 「名前=値」 の形で1行ずつ書きます。= の前後にスペースは不要です。
#  「#」から始まる行はメモ（コメント）なので無視されます。
#  各キーの取り方は SETUP.md を見てください。
# =====================================================================


# ---------------------------------------------------------------------
#  全体の設定
# ---------------------------------------------------------------------
# 失敗した投稿を何回まで再挑戦するか（超えたら「投稿失敗」フォルダへ移動）
MAX_RETRY=5


# ---------------------------------------------------------------------
#  YouTube
# ---------------------------------------------------------------------
# 使うなら true、使わないなら false
YOUTUBE_ENABLED=true
# Google Cloud からダウンロードした OAuth クライアントのファイル名
# （このツールのフォルダに置いてください）
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
# 公開設定: public（公開） / unlisted（限定公開） / private（非公開）
# ※ Google の審査（監査）前のプロジェクトは、ここを public にしても非公開になります
YOUTUBE_PRIVACY=public
# カテゴリ番号（22=ブログ, 24=エンターテイメント, 10=音楽, 20=ゲーム, 26=ハウツーとスタイル）
YOUTUBE_CATEGORY_ID=22
# 子ども向け動画なら true
YOUTUBE_MADE_FOR_KIDS=false


# ---------------------------------------------------------------------
#  TikTok
# ---------------------------------------------------------------------
TIKTOK_ENABLED=true
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TikTok開発者サイトに登録した「Redirect URI」と全く同じものを書きます
TIKTOK_REDIRECT_URI=http://localhost:8765/callback/
# 投稿方法:
#   direct = 直接投稿（審査前は「自分のみ」公開＝非公開でしか投稿できません）
#   inbox  = 下書きとしてTikTokアプリに送る（アプリで通知を開いて自分で投稿ボタンを押す）
TIKTOK_MODE=direct
# 公開範囲（direct のとき）:
#   SELF_ONLY（自分のみ） / MUTUAL_FOLLOW_FRIENDS（相互フォロー） /
#   FOLLOWER_OF_CREATOR（フォロワー） / PUBLIC_TO_EVERYONE（全員）
# ※ 審査前は SELF_ONLY しか使えません
TIKTOK_PRIVACY=SELF_ONLY


# ---------------------------------------------------------------------
#  X（旧Twitter）
# ---------------------------------------------------------------------
# ※ X API は投稿ごとに料金がかかります（事前にクレジットの購入が必要）
X_ENABLED=true
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=


# ---------------------------------------------------------------------
#  Threads
# ---------------------------------------------------------------------
THREADS_ENABLED=true
# Meta開発者サイトの「ユーザートークン生成ツール」で作ったトークン
# （一度設定すれば、ツールが自動で延長します）
THREADS_ACCESS_TOKEN=

# Threads は「インターネット上で公開されている動画のURL」しか受け付けません。
# 動画を一時的に置く場所の設定です（詳しくは SETUP.md）。
#   manual = 自分で動画をアップロードし、投稿内容.txt の【動画URL】に書く
#   s3     = Cloudflare R2 / Amazon S3 に自動でアップロードする（おすすめ）
THREADS_VIDEO_HOSTING=s3
# 以下は THREADS_VIDEO_HOSTING=s3 のときだけ必要
# Cloudflare R2 の場合: https://<アカウントID>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# R2 の場合は auto のままでOK
S3_REGION=auto
